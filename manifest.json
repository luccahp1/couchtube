{
  "manifest_version": 3,
  "name": "CouchTube - Controller UI for YouTube and Netflix",
  "version": "0.2.0",
  "description": "Turns YouTube and Netflix into a 10-foot console interface you can drive entirely with a game controller.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.youtube.com/*",
        "*://m.youtube.com/*",
        "*://www.netflix.com/*"
      ],
      "run_at": "document_idle",
      "all_frames": false,
      "js": [
        "src/util.js",
        "src/settings.js",
        "src/mapping.js",
        "src/gamepad.js",
        "src/spatial.js",
        "src/ui.js",
        "src/hud.js",
        "src/osk.js",
        "src/menu.js",
        "src/yt.js",
        "src/nf.js",
        "src/site.js",
        "src/app.js"
      ]
    },
    {
      "matches": ["*://www.netflix.com/*"],
      "run_at": "document_idle",
      "all_frames": false,
      "world": "MAIN",
      "js": ["src/nfx.js"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/overlay.css"],
      "matches": [
        "*://www.youtube.com/*",
        "*://m.youtube.com/*",
        "*://www.netflix.com/*"
      ]
    }
  ],
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "CouchTube",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "128": "icons/icon128.png"
    }
  }
}
